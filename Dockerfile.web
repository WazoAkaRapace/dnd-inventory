# Web: React + Vite → served by nginx
FROM node:20-alpine AS builder
WORKDIR /app

# Install all workspace dependencies
COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm ci || npm install

# Copy source — shared types + web app
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

# Build the frontend (API URL injected at build time via VITE_API_URL)
# Empty VITE_API_URL means the frontend uses same-origin (nginx proxies /api)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /app/apps/web
RUN npx vite build

# --- Production stage: nginx ---
FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
